local OWNER  = "TYPOIDEB"
local REPO   = "rayfield_cheat_mm2"
local BRANCH = "main"

local RAW_BASE     = ("https://raw.githubusercontent.com/%s/%s/%s/"):format(OWNER, REPO, BRANCH)
local API_BASE     = ("https://api.github.com/repos/%s/%s/contents"):format(OWNER, REPO)
local VERSION_URL  = RAW_BASE .. "file.txt"
local MANIFEST_URL = RAW_BASE .. "manifest.txt"

local HUB_FOLDER   = "MM2Hub"
local HUB_DIR      = HUB_FOLDER .. "/"
local VERSION_FILE = HUB_DIR .. "version.txt"

local Stats = {
    total = 0, downloaded = 0, fromDisk = 0,
    failed = 0, bytesDown = 0, version = "?",
    manifestUsed = false,
}

local function fsReady()
    return type(isfile) == "function"
       and type(readfile) == "function"
       and type(writefile) == "function"
end

local function ensureFolder(path)
    if type(isfolder) ~= "function" or type(makefolder) ~= "function" then return end
    local ok, exists = pcall(isfolder, path)
    if ok and not exists then pcall(makefolder, path) end
end

local function deleteFolderContents(path)
    if type(listfiles) ~= "function" or type(delfile) ~= "function" or type(isfolder) ~= "function" then return end
    local ok, exists = pcall(isfolder, path)
    if not ok or not exists then return end
    local lok, list = pcall(listfiles, path)
    if not lok or type(list) ~= "table" then return end
    for _, p in ipairs(list) do pcall(delfile, p) end
end

local function httpGet(url)
    if type(game.HttpGet) == "function" then
        local ok, res = pcall(game.HttpGet, game, url)
        if ok and type(res) == "string" then return res end
    end
    if type(game.HttpGetAsync) == "function" then
        local ok, res = pcall(game.HttpGetAsync, game, url)
        if ok and type(res) == "string" then return res end
    end
    return nil
end

local function readRemoteVersion()
    local data = httpGet(VERSION_URL .. "?t=" .. tostring(os.time()))
    if not data then return nil end
    for line in data:gmatch("[^\r\n]+") do
        line = line:gsub("^%s+", ""):gsub("%s+$", "")
        if line ~= "" and not line:match("^#") then return line end
    end
    return nil
end

local function readLocalVersion()
    if not fsReady() or not isfile(VERSION_FILE) then return nil end
    local ok, data = pcall(readfile, VERSION_FILE)
    if ok and type(data) == "string" then return data:gsub("%s+", "") end
    return nil
end

local function writeLocalVersion(v)
    if not fsReady() then return end
    ensureFolder(HUB_FOLDER)
    pcall(writefile, VERSION_FILE, v)
end

local function parseManifest(data)
    local mods = {}
    if type(data) ~= "string" then return mods end
    for line in data:gmatch("[^\r\n]+") do
        line = line:gsub("^%s+", ""):gsub("%s+$", "")
        if line ~= "" and not line:match("^#") then
            local path, ver = line:match("^([^|]+)|(.+)$")
            if not path then path, ver = line:match("^([^%s]+)%s+(.+)$") end
            if path then
                path = path:gsub("%s+$", "")
                ver  = (ver or "no-version"):gsub("%s+$", "")
                table.insert(mods, { path = path, ver = ver })
            end
        end
    end
    return mods
end

local function readRemoteManifest()
    local data = httpGet(MANIFEST_URL .. "?t=" .. tostring(os.time()))
    if not data then return nil end
    local mods = parseManifest(data)
    if #mods == 0 then return nil end
    return mods
end

local function parseJsonList(response)
    local items = {}
    if type(response) ~= "string" then return items end
    if response:match("^%s*{") and response:find('"message"', 1, true) then return items end
    for chunk in response:gmatch("{.-}") do
        local name = chunk:match('"name"%s*:%s*"([^"]+)"')
        local typ  = chunk:match('"type"%s*:%s*"([^"]+)"')
        if name and (typ == "file" or typ == "dir") then
            table.insert(items, { name = name, type = typ })
        end
    end
    return items
end

local function scanRepo()
    local files = {}
    local queue = { "" }
    while #queue > 0 do
        local folder = table.remove(queue, 1)
        local url = (folder == "") and (API_BASE .. "?ref=" .. BRANCH)
                                 or (API_BASE .. "/" .. folder .. "?ref=" .. BRANCH)
        local response = httpGet(url)
        if response then
            for _, item in ipairs(parseJsonList(response)) do
                local fullPath = (folder == "" and "" or (folder .. "/")) .. item.name
                if item.type == "file" and item.name:match("%.lua$") then
                    if not (folder == "" and item.name == "main.lua") then
                        table.insert(files, fullPath)
                    end
                elseif item.type == "dir" then
                    table.insert(queue, fullPath)
                end
            end
        end
    end
    return files
end

local function ensureModule(mod)
    local safeName  = mod.path:gsub("[/\\]", "_")
    local localPath = HUB_DIR .. safeName
    local verPath   = HUB_DIR .. safeName .. ".ver"

    local function readLocalVer()
        if not fsReady() or not isfile(verPath) then return nil end
        local ok, v = pcall(readfile, verPath)
        if ok and type(v) == "string" then return v:gsub("%s+", "") end
        return nil
    end

    local function readLocalFile()
        if not fsReady() or not isfile(localPath) then return nil end
        local ok, d = pcall(readfile, localPath)
        if ok and type(d) == "string" and #d > 0 then return d end
        return nil
    end

    local localVer  = readLocalVer()
    local localData = readLocalFile()

    if not mod.ver or mod.ver == "no-version" then
        local src = httpGet(RAW_BASE .. mod.path .. "?t=" .. tostring(os.time()))
        if not src or #src == 0 then
            if localData then Stats.fromDisk = Stats.fromDisk + 1; return localData end
            Stats.failed = Stats.failed + 1
            return nil
        end
        if localData == src then
            Stats.fromDisk = Stats.fromDisk + 1
            return localData
        end
        if fsReady() then
            ensureFolder(HUB_FOLDER)
            pcall(writefile, localPath, src)
        end
        Stats.downloaded = Stats.downloaded + 1
        Stats.bytesDown = Stats.bytesDown + #src
        return src
    end

    if localVer == mod.ver and localData then
        Stats.fromDisk = Stats.fromDisk + 1
        return localData
    end

    local src = httpGet(RAW_BASE .. mod.path .. "?v=" .. tostring(mod.ver))
    if not src or #src == 0 then
        if localData then Stats.fromDisk = Stats.fromDisk + 1; return localData end
        Stats.failed = Stats.failed + 1
        return nil
    end

    if fsReady() then
        ensureFolder(HUB_FOLDER)
        local wok = pcall(writefile, localPath, src)
        if wok then
            pcall(writefile, verPath, mod.ver)
        end
    end
    Stats.downloaded = Stats.downloaded + 1
    Stats.bytesDown = Stats.bytesDown + #src
    return src
end

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "MM2 Hub",
    LoadingTitle = "Загрузка MM2 Hub...",
    LoadingSubtitle = "by " .. OWNER,
    ConfigurationSaving = { Enabled = true, FolderName = "MM2Hub", FileName = "Config" },
    KeySystem = false
})

local Context = {
    Rayfield         = Rayfield,
    Window           = Window,
    Players          = game:GetService("Players"),
    RunService       = game:GetService("RunService"),
    UserInputService = game:GetService("UserInputService"),
    LocalPlayer      = game:GetService("Players").LocalPlayer,
    Loaded           = {},
    Toggles          = {},
    ShutdownHandlers = {},
    ShutdownResponses = {},
    Alive            = true,
    Exiting          = false,
}

function Context.RegisterToggle(t)
    if t and t.Set then table.insert(Context.Toggles, t) end
end

function Context.RegisterShutdown(name, fn)
    Context.ShutdownHandlers[name] = fn
end

function Context.MarkShutdownDone(name)
    Context.ShutdownResponses[name] = true
end

function Context.DisableAll()
    for _, t in ipairs(Context.Toggles) do
        pcall(function() t:Set(false) end)
    end
    if Rayfield.Flags and type(Rayfield.Flags) == "table" then
        for k, v in pairs(Rayfield.Flags) do
            if type(v) == "boolean" then Rayfield.Flags[k] = false end
        end
    end
end

function Context.SweepNow()
    for _, obj in ipairs(workspace:GetDescendants()) do
        local ok, name = pcall(function() return obj.Name end)
        if ok and type(name) == "string" and name:match("^MM2_") then
            pcall(function() obj:Destroy() end)
        end
    end
end

function Context.ExitSequence()
    if Context.Exiting then return end
    Context.Exiting = true

    Context.DisableAll()

    Rayfield:Notify({
        Title = "MM2 Hub",
        Content = "Отправляю команду exit модулям...",
        Duration = 3
    })

    local names = {}
    for name in pairs(Context.ShutdownHandlers) do
        table.insert(names, name)
    end

    print(("[MM2 Hub] Отправляю команду exit модулям (всего: %d)"):format(#names))

    if #names == 0 then
        print("[MM2 Hub] Модулей нет — закрываюсь сразу")
        Context.Alive = false
        Context.SweepNow()
        pcall(function() Rayfield:Destroy() end)
        return
    end

    Context.Alive = false

    for _, name in ipairs(names) do
        local fn = Context.ShutdownHandlers[name]
        task.spawn(function()
            local ok, err = pcall(fn, Context)
            if not ok then
                warn(("[MM2 Hub] Модуль '%s' упал при exit: %s"):format(name, tostring(err)))
            end
            Context.MarkShutdownDone(name)
        end)
    end

    local startTime = os.clock()
    local lastReported = -1
    local timeout = 15

    while true do
        task.wait(0.1)
        local elapsed = math.floor(os.clock() - startTime)

        if elapsed > lastReported then
            lastReported = elapsed

            local done = 0
            for _, name in ipairs(names) do
                if Context.ShutdownResponses[name] then done = done + 1 end
            end

            print(("[MM2 Hub] Отсчёт: %d сек | Ответили: %d/%d"):format(elapsed, done, #names))

            if done >= #names then break end
            if elapsed >= timeout then
                local pending = {}
                for _, name in ipairs(names) do
                    if not Context.ShutdownResponses[name] then
                        table.insert(pending, name)
                    end
                end
                warn("[MM2 Hub] Таймаут! Не ответили: " .. table.concat(pending, ", "))
                break
            end
        end
    end

    print(("[MM2 Hub] Прошло %.2f секунд перед тем как ответили все модули"):format(os.clock() - startTime))

    Context.SweepNow()
    task.wait(0.2)
    Context.SweepNow()

    pcall(function() Rayfield:Destroy() end)
end

local originalDestroy = Rayfield.Destroy
Rayfield.Destroy = function(self, ...)
    if Context.Exiting then
        return originalDestroy(self, ...)
    end
    task.spawn(function() Context.ExitSequence() end)
end

local function loadModule(path, src)
    if type(src) ~= "string" then Stats.failed = Stats.failed + 1; return false end

    local fn, err = loadstring(src, path)
    if not fn then
        warn(("[MM2 Hub] Синтаксис '%s': %s"):format(path, tostring(err)))
        Stats.failed = Stats.failed + 1
        return false
    end

    local okRun, result = pcall(fn)
    if not okRun then
        warn(("[MM2 Hub] Runtime '%s': %s"):format(path, tostring(result)))
        Stats.failed = Stats.failed + 1
        return false
    end

    if type(result) ~= "table" or type(result.Init) ~= "function" then
        warn(("[MM2 Hub] '%s' не вернул {Init=function}"):format(path))
        Stats.failed = Stats.failed + 1
        return false
    end

    local fileName = path:match("([^/\\]+)$") or path
    local tabName  = fileName:gsub("%.lua$", "")
    local tabIcon  = result.Icon or 4483362458

    local Tab = Window:CreateTab(tabName, tabIcon)

    local okInit, initErr = pcall(result.Init, Context, Tab)
    if not okInit then
        warn(("[MM2 Hub] Init '%s': %s"):format(path, tostring(initErr)))
        Stats.failed = Stats.failed + 1
        return false
    end

    Context.Loaded[path] = true
    print(("[MM2 Hub] Загружен модуль: %s"):format(path))
    return true
end

local function formatBytes(b)
    if b < 1024 then return b .. " B" end
    if b < 1024 * 1024 then return string.format("%.1f KB", b / 1024) end
    return string.format("%.2f MB", b / (1024 * 1024))
end

local ExitTab = Window:CreateTab("Exit", 4483362458)
ExitTab:CreateSection("Выход")
ExitTab:CreateButton({
    Name = "Выключить всё и выйти",
    Callback = function() Context.ExitSequence() end,
})

local remoteVersion = readRemoteVersion()
if not remoteVersion then
    Rayfield:Notify({ Title = "MM2 Hub", Content = "Не удалось прочитать file.txt", Duration = 8 })
    return
end
Stats.version = remoteVersion

local localVersion = readLocalVersion()
if localVersion == nil then
    ensureFolder(HUB_FOLDER)
    writeLocalVersion(remoteVersion)
elseif localVersion ~= remoteVersion then
    print(("[MM2 Hub] Глобальная версия: %s -> %s, чищу папку"):format(localVersion, remoteVersion))
    deleteFolderContents(HUB_FOLDER)
    ensureFolder(HUB_FOLDER)
    writeLocalVersion(remoteVersion)
end

local modules
local manifest = readRemoteManifest()
if manifest then
    modules = manifest
    Stats.manifestUsed = true
    print(("[MM2 Hub] Использую manifest.txt (%d модулей)"):format(#modules))
else
    print("[MM2 Hub] manifest.txt не найден — fallback (сравнение содержимого).")
    local files = scanRepo()
    modules = {}
    for _, path in ipairs(files) do
        table.insert(modules, { path = path, ver = nil })
    end
end

Stats.total = #modules
if #modules == 0 then
    Rayfield:Notify({ Title = "MM2 Hub", Content = "Модулей не найдено", Duration = 6 })
    return
end

table.sort(modules, function(a, b) return a.path < b.path end)

for _, mod in ipairs(modules) do
    if not Context.Alive then break end
    local src = ensureModule(mod)
    if src then loadModule(mod.path, src) end
end

local summary = ("Найдено: %d | Скачано: %d | Из диска: %d | Ошибки: %d\nТрафик: %s%s"):format(
    Stats.total, Stats.downloaded, Stats.fromDisk, Stats.failed, formatBytes(Stats.bytesDown),
    Stats.manifestUsed and "\nСверка: по manifest.txt" or "\nСверка: fallback (сравнение содержимого)"
)

Rayfield:Notify({
    Title = ("MM2 Hub — %s"):format(remoteVersion),
    Content = summary,
    Duration = 8
})